# 复制为 .env 后填入本地开发值；生产环境请通过真实环境变量注入。
MEDITOUR_SECRET_KEY=replace-with-a-long-random-string
# 可选：单处金额币种，默认 EUR
MEDITOUR_CURRENCY=EUR
# 可选：CORS 允许来源，逗号分隔；默认 http://localhost:8123,http://127.0.0.1:8123
# MEDITOUR_CORS_ORIGINS=https://app.example.com
# 可选：是否创建演示账号 demo@meditour.com（默认关闭；生产环境不要开启）
MEDITOUR_SEED_DEMO_USER=1
# 可选：令牌有效期（天），默认 access=7、refresh=30
# MEDITOUR_ACCESS_TOKEN_EXPIRE_DAYS=7
# MEDITOUR_REFRESH_TOKEN_EXPIRE_DAYS=30
# 可选：SQLite 路径或其它 SQLAlchemy URL
# DATABASE_URL=sqlite:///./meditour.db
# PostgreSQL 示例（需要 psycopg，docker-compose.yml 已按此配置）：
# DATABASE_URL=postgresql+psycopg://meditour:password@127.0.0.1:5432/meditour
# 可选：全局请求体上限（字节），默认 10485760（10 MiB），需大于上传上限
# MEDITOUR_MAX_REQUEST_BYTES=10485760
# 可选：单张上传图片上限（字节），默认 5242880（5 MiB）
# MEDITOUR_UPLOAD_MAX_BYTES=5242880
# 可选：忘记密码令牌有效期（分钟），默认 30
# MEDITOUR_RESET_TOKEN_EXPIRE_MINUTES=30
# 可选：重置邮件里链接的站点地址，默认 http://localhost:8123
# MEDITOUR_PUBLIC_BASE_URL=https://app.example.com
# 邮件实现：file（开发默认，写入 outbox 文件，不会真正发信）/ smtp（生产）
MEDITOUR_MAIL_BACKEND=file
# file 后端的输出文件；默认 backend/var/mail_outbox.log（已被 .gitignore 忽略）
# MEDITOUR_MAIL_OUTBOX=./var/mail_outbox.log
# file 后端生成的完整邮件（.eml，HTML+纯文本）预览目录，默认 backend/var/mail_preview
# MEDITOUR_MAIL_PREVIEW_DIR=./var/mail_preview
# smtp 后端配置位：缺少 HOST 时发送会直接报错，不会假装成功
# MEDITOUR_SMTP_HOST=smtp.example.com
# MEDITOUR_SMTP_PORT=587
# MEDITOUR_SMTP_USER=
# MEDITOUR_SMTP_PASSWORD=
# MEDITOUR_SMTP_FROM=no-reply@meditour.com
# MEDITOUR_SMTP_STARTTLS=1
